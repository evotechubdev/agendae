rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function manages(slug) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.establishmentSlug == slug;
    }

    function isSystemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/systemAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/systemAdmins/$(request.auth.uid)).data.active == true;
    }

    function administers(slug) {
      return manages(slug)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function published(slug) {
      return get(/databases/$(database)/documents/establishments/$(slug)).data.get('setupComplete', true) == true;
    }

    match /systemAdmins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    function validCheckInToken(slug, token) {
      return token is string
        && exists(/databases/$(database)/documents/establishments/$(slug)/checkIn/config)
        && get(/databases/$(database)/documents/establishments/$(slug)/checkIn/config).data.token == token;
    }

    function presenceWithinWindow(slug, appointment) {
      let dateParts = appointment.date.split('-');
      let timeParts = appointment.time.split(':');
      let day = timestamp.date(int(dateParts[0]), int(dateParts[1]), int(dateParts[2]));
      let start = day + duration.value(int(timeParts[0]) * 60 + int(timeParts[1]) + 180, 'm');
      let establishment = get(/databases/$(database)/documents/establishments/$(slug)).data;
      let minutes = appointment.get('durationMinutes', establishment.get('serviceDurations', {}).get(appointment['service'], 20));
      return (request.time - duration.value(3, 'h')).date() == day
        && minutes is int && minutes > 0 && minutes <= 1440
        && request.time >= start - duration.value(1, 'h')
        && request.time <= start + duration.value(minutes, 'm');
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);
      allow create: if isSystemAdmin()
        && request.resource.data.role == 'admin'
        && request.resource.data.establishmentSlug is string
        && getAfter(/databases/$(database)/documents/establishments/$(request.resource.data.establishmentSlug)).data.setupComplete == false;
      allow update: if ownsProfile(userId)
        && request.resource.data.establishmentSlug == resource.data.establishmentSlug
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /establishments/{slug} {
      allow read: if true;
      allow create: if isSystemAdmin()
        && request.resource.data.slug == slug
        && request.resource.data.active == true
        && request.resource.data.setupComplete == false
        && request.resource.data.professionals == []
        && request.resource.data.services == [];
      allow delete: if false;
      allow update: if (manages(slug)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'scheduleMode', 'professionalLunchBreaks', 'professionals',
          'availableTimes', 'services', 'serviceDurations',
          'extraWorkingDates', 'staffClosedDates', 'updatedAt'
        ])) || (administers(slug)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'initials', 'category', 'neighborhood', 'address',
            'hours', 'setupComplete', 'updatedAt'
          ])
          && (request.resource.data.get('setupComplete', true) != true || (
            request.resource.data.name is string
            && request.resource.data.name != 'Estabelecimento em configuração'
            && request.resource.data.name.size() > 0
            && request.resource.data.category is string
            && request.resource.data.category.size() > 0
            && request.resource.data.neighborhood is string
            && request.resource.data.neighborhood.size() > 0
            && request.resource.data.address is string
            && request.resource.data.address.size() > 0
            && request.resource.data.hours is list
            && request.resource.data.hours.size() > 0
            && request.resource.data.professionals is list
            && request.resource.data.professionals.size() > 0
            && request.resource.data.availableTimes is list
            && request.resource.data.availableTimes.size() > 0
            && request.resource.data.services is list
            && request.resource.data.services.size() > 0
          )));

      match /public/{documentId} {
        allow read: if true;
        allow write: if manages(slug);
      }

      match /slots/{slotId} {
        function validPresenceConfirmation() {
          let appointmentId = request.resource.data.appointmentId;
          let appointment = getAfter(/databases/$(database)/documents/establishments/$(slug)/appointments/$(appointmentId)).data;
          return appointmentId is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appointmentId', 'status', 'checkedInAt', 'checkInMethod'])
            && request.resource.data.status == 'presente'
            && request.resource.data.checkedInAt == request.time
            && request.resource.data.checkInMethod == 'qr'
            && resource.data.date == appointment.date
            && resource.data.time == appointment.time
            && resource.data.professional == appointment.professional
            && resource.data['service'] == appointment['service']
            && appointment.status == 'presente'
            && presenceWithinWindow(slug, appointment)
            && validCheckInToken(slug, appointment.checkInToken)
            && getAfter(/databases/$(database)/documents/establishments/$(slug)/appointmentPresence/$(appointmentId)).data.status == 'presente';
        }
        allow read: if true;
        allow create: if published(slug) && (manages(slug)
          || (request.resource.data.keys().hasOnly(['date', 'time', 'service', 'professional', 'createdAt'])
            && request.resource.data.date is string
            && request.resource.data.time is string
            && request.resource.data['service'] is string
            && request.resource.data.professional is string
            && getAfter(/databases/$(database)/documents/establishments/$(slug)).data.get('staffClosedDates', {}).get(request.resource.data.professional, '') != request.resource.data.date));
        allow update: if (manages(slug)
            && (request.resource.data.get('status', '') != 'presente'
              || resource.data.get('status', '') == 'presente'
              || presenceWithinWindow(slug, getAfter(/databases/$(database)/documents/establishments/$(slug)/appointments/$(request.resource.data.appointmentId)).data)))
          || validPresenceConfirmation();
        allow delete: if manages(slug);
      }

      match /appointments/{appointmentId} {
        allow create: if published(slug) && (manages(slug)
          || (request.resource.data.keys().hasOnly([
            'id', 'date', 'time', 'client', 'phone', 'service',
            'professional', 'status', 'checkInCode', 'createdAt', 'durationMinutes'
          ])
          && request.resource.data.date is string
          && request.resource.data.time is string
          && request.resource.data.client is string
          && request.resource.data.phone is string
          && request.resource.data['service'] is string
          && request.resource.data.checkInCode is string
          && request.resource.data.checkInCode.size() == 6
          && request.resource.data.get('durationMinutes', 20) is int
          && request.resource.data.get('durationMinutes', 20) > 0
           && request.resource.data.get('durationMinutes', 20) <= 1440
           && request.resource.data.status == 'confirmado'
            && getAfter(/databases/$(database)/documents/establishments/$(slug)).data.get('staffClosedDates', {}).get(request.resource.data.professional, '') != request.resource.data.date));
        allow read, delete: if manages(slug);
        allow update: if (manages(slug)
            && (request.resource.data.status != 'presente' || resource.data.status == 'presente' || presenceWithinWindow(slug, resource.data)))
          || (resource.data.status == 'confirmado'
            && request.resource.data.status == 'presente'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'checkedInAt', 'checkInMethod', 'checkInToken'
            ])
            && request.resource.data.checkedInAt == request.time
            && request.resource.data.checkInMethod == 'qr'
            && presenceWithinWindow(slug, resource.data)
            && validCheckInToken(slug, request.resource.data.checkInToken)
            && getAfter(/databases/$(database)/documents/establishments/$(slug)/appointmentPresence/$(appointmentId)).data.status == 'presente');
      }

      match /appointmentLookups/{lookupKey} {
        function validPublicAppointment(item) {
          let appointment = getAfter(/databases/$(database)/documents/establishments/$(slug)/appointments/$(item.appointmentId)).data;
          return item.keys().hasOnly(['appointmentId', 'date', 'time', 'service', 'professional', 'status', 'durationMinutes'])
            && item.get('durationMinutes', 20) == appointment.get('durationMinutes', 20)
            && item.date == appointment.date
            && item.time == appointment.time
            && item['service'] == appointment['service']
            && item.professional == appointment.professional
            && item.status == appointment.status;
        }

        allow get: if true;
        allow list: if false;
        allow create: if request.resource.data.keys().hasOnly(['appointments', 'updatedAt'])
          && request.resource.data.appointments is list
          && request.resource.data.appointments.size() == 1
          && validPublicAppointment(request.resource.data.appointments[0]);
        allow update: if manages(slug)
          || (request.resource.data.keys().hasOnly(['appointments', 'updatedAt'])
            && request.resource.data.appointments is list
            && request.resource.data.appointments.size() == resource.data.appointments.size() + 1
            && request.resource.data.appointments.hasAll(resource.data.appointments)
            && validPublicAppointment(request.resource.data.appointments[resource.data.appointments.size()]));
        allow delete: if manages(slug);
      }

      match /appointmentCodeLookups/{lookupKey} {
        function validCodeAppointment(item) {
          let appointment = getAfter(/databases/$(database)/documents/establishments/$(slug)/appointments/$(item.appointmentId)).data;
          return item.keys().hasOnly(['appointmentId', 'date', 'time', 'service', 'professional', 'status', 'durationMinutes'])
            && item.get('durationMinutes', 20) == appointment.get('durationMinutes', 20)
            && item.date == appointment.date
            && item.time == appointment.time
            && item['service'] == appointment['service']
            && item.professional == appointment.professional
            && item.status == appointment.status;
        }

        allow get: if true;
        allow list: if false;
        allow create: if request.resource.data.keys().hasOnly(['appointments', 'updatedAt'])
          && request.resource.data.appointments is list
          && request.resource.data.appointments.size() == 1
          && validCodeAppointment(request.resource.data.appointments[0]);
        allow update, delete: if manages(slug);
      }

      match /appointmentPresence/{appointmentId} {
        function matchingAppointment() {
          return getAfter(/databases/$(database)/documents/establishments/$(slug)/appointments/$(appointmentId)).data;
        }

        allow get: if true;
        allow list: if false;
        allow create: if (manages(slug)
            && (request.resource.data.status != 'presente' || presenceWithinWindow(slug, matchingAppointment())))
          || (request.resource.data.keys().hasOnly(['appointmentId', 'date', 'status', 'createdAt'])
            && request.resource.data.appointmentId == appointmentId
            && request.resource.data.date == matchingAppointment().date
            && request.resource.data.status == 'confirmado'
            && matchingAppointment().status == 'confirmado')
          || (request.resource.data.keys().hasOnly([
              'appointmentId', 'date', 'status', 'checkedInAt', 'checkInMethod'
            ])
            && request.resource.data.appointmentId == appointmentId
            && request.resource.data.date == matchingAppointment().date
            && request.resource.data.status == 'presente'
            && presenceWithinWindow(slug, matchingAppointment())
            && request.resource.data.checkedInAt == request.time
            && request.resource.data.checkInMethod == 'qr'
            && validCheckInToken(slug, matchingAppointment().checkInToken)
            && matchingAppointment().status == 'presente');
        allow update: if (manages(slug)
            && (request.resource.data.status != 'presente' || resource.data.status == 'presente' || presenceWithinWindow(slug, matchingAppointment())))
          || (resource.data.status == 'confirmado'
            && request.resource.data.status == 'presente'
            && presenceWithinWindow(slug, matchingAppointment())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'checkedInAt', 'checkInMethod'
            ])
            && request.resource.data.checkedInAt == request.time
            && request.resource.data.checkInMethod == 'qr'
            && validCheckInToken(slug, matchingAppointment().checkInToken)
            && matchingAppointment().status == 'presente');
        allow delete: if manages(slug);
      }

      match /checkIn/{documentId} {
        allow read, write: if manages(slug);
      }

      match /staffStatus/{professionalId} {
        allow read: if true;
        allow write: if manages(slug);
      }

      match /apiAccess/{documentId} {
        allow read, write: if false;
      }

      match /queue/{queueId} {
        allow read, write: if manages(slug);
      }
    }
  }
}
