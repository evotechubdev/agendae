rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function manages(slug) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.establishmentSlug == slug;
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);
      allow create: if false;
      allow update: if ownsProfile(userId)
        && request.resource.data.establishmentSlug == resource.data.establishmentSlug
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /establishments/{slug} {
      allow read: if true;
      allow write: if manages(slug);

      match /public/{documentId} {
        allow read: if true;
        allow write: if manages(slug);
      }

      match /slots/{slotId} {
        allow read: if true;
        allow create: if manages(slug)
          || (request.resource.data.keys().hasOnly(['date', 'time', 'service', 'professional', 'createdAt'])
            && request.resource.data.date is string
            && request.resource.data.time is string
            && request.resource.data['service'] is string
            && request.resource.data.professional is string);
        allow update, delete: if manages(slug);
      }

      match /appointments/{appointmentId} {
        allow create: if manages(slug)
          || (request.resource.data.keys().hasOnly([
            'id', 'date', 'time', 'client', 'phone', 'service',
            'professional', 'status', 'createdAt'
          ])
          && request.resource.data.date is string
          && request.resource.data.time is string
          && request.resource.data.client is string
          && request.resource.data.phone is string
          && request.resource.data['service'] is string
          && request.resource.data.status == 'confirmado');
        allow read, update, delete: if manages(slug);
      }

      match /appointmentLookups/{lookupKey} {
        function validPublicAppointment(item) {
          let appointment = getAfter(/databases/$(database)/documents/establishments/$(slug)/appointments/$(item.appointmentId)).data;
          return item.keys().hasOnly(['appointmentId', 'date', 'time', 'service', 'professional', 'status'])
            && item.date == appointment.date
            && item.time == appointment.time
            && item['service'] == appointment['service']
            && item.professional == appointment.professional
            && item.status == appointment.status;
        }

        allow get: if true;
        allow list: if false;
        allow create: if request.resource.data.keys().hasOnly(['appointments', 'updatedAt'])
          && request.resource.data.appointments is list
          && request.resource.data.appointments.size() == 1
          && validPublicAppointment(request.resource.data.appointments[0]);
        allow update: if manages(slug)
          || (request.resource.data.keys().hasOnly(['appointments', 'updatedAt'])
            && request.resource.data.appointments is list
            && request.resource.data.appointments.size() == resource.data.appointments.size() + 1
            && request.resource.data.appointments.hasAll(resource.data.appointments)
            && validPublicAppointment(request.resource.data.appointments[resource.data.appointments.size()]));
        allow delete: if manages(slug);
      }

      match /queue/{queueId} {
        allow read, write: if manages(slug);
      }
    }
  }
}
